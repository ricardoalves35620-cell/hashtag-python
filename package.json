{
  "name": "hashtag-python",
  "private": true,
  "version": "10.25.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "audit:install": "playwright install chromium webkit",
    "audit:content": "tsx audit/content-audit.ts",
    "audit:visual": "playwright test",
    "audit": "npm run audit:content && npm run audit:visual",
    "audit:autopilot": "tsx audit/autopilot.ts",
    "quality:gate": "npm run typecheck && npm run test && npm run build && npm run audit:content && npm run audit:curriculum && npm run audit:v11:gate && npm run audit:budget && npm audit --audit-level=high",
    "audit:state": "node scripts/audit/check-audit-state.mjs",
    "audit:content:free-values": "tsx scripts/audit/free-values.ts 68",
    "audit:content:dead-stores": "tsx scripts/audit/dead-stores.ts",
    "audit:content:drift": "tsx scripts/audit/bilingual-drift.ts",
    "audit:content:expectations": "tsx scripts/audit/dump-exercises.ts && node scripts/audit/python.mjs scripts/audit/verify-expectations.py",
    "audit:content:parity": "tsx scripts/audit/dump-exercises.ts && node scripts/audit/python.mjs scripts/audit/coverage-parity.py",
    "audit:content:cheat": "tsx scripts/audit/dump-exercises.ts && node scripts/audit/python.mjs scripts/audit/cheat-resistance.py",
    "audit:device-fit": "node scripts/audit/device-fit.mjs",
    "audit:offline": "node scripts/audit/offline-reload.mjs",
    "audit:learner": "node scripts/audit/python.mjs scripts/audit/dump-references.py && tsx scripts/audit/localize-references.ts && tsx scripts/audit/learner-agent.ts",
    "audit:learner:legacy": "node scripts/audit/learner-walkthrough.mjs",
    "audit:language": "tsx scripts/audit/language-isolation.ts",
    "audit:retranslate": "node scripts/audit/python.mjs scripts/audit/dump-references.py && tsx scripts/audit/localize-references.ts && tsx scripts/audit/dump-exercises.ts && node scripts/audit/python.mjs scripts/audit/retranslate-outputs.py",
    "audit:content:described": "node scripts/audit/python.mjs scripts/audit/dump-references.py && tsx scripts/audit/localize-references.ts && tsx scripts/audit/dump-exercises.ts && node scripts/audit/python.mjs scripts/audit/described-output.py",
    "audit:portunol": "tsx scripts/audit/portunol.ts",
    "audit:presentation": "tsx scripts/audit/presentation-tolerance.ts",
    "audit:sw": "node scripts/audit/sw-update-policy.mjs",
    "audit:pt-grading": "node scripts/audit/python.mjs scripts/audit/dump-references.py && tsx scripts/audit/localize-references.ts && tsx scripts/audit/dump-exercises.ts && node scripts/audit/pt-grading.mjs",
    "audit:content:extra": "npm run audit:content:free-values && npm run audit:content:dead-stores && npm run audit:content:drift && npm run audit:content:expectations && npm run audit:content:parity && npm run audit:content:cheat && npm run audit:presentation && npm run audit:portunol && npm run audit:content:described",
    "audit:slim": "node scripts/audit/create-slim-report.mjs",
    "audit:pedagogy": "tsx audit/curriculum-audit.ts",
    "audit:curriculum": "tsx audit/curriculum-audit.ts",
    "audit:smart": "tsx audit/autopilot.ts --mode smart --cycles 0 --batch 3",
    "audit:smoke": "tsx audit/autopilot.ts --mode smoke --cycles 0 --batch 5",
    "audit:night": "powershell -ExecutionPolicy Bypass -File ./run-auditor-night.ps1 -Hours 8",
    "audit:v11": "tsx audit/v11-readiness.ts",
    "audit:v11:gate": "tsx audit/v11-quality-gate.ts",
    "audit:v11:baseline": "tsx audit/v11-quality-gate.ts --write-baseline",
    "audit:budget": "node scripts/audit/check-bundle-budget.mjs",
    "audit:budget:update": "node scripts/audit/check-bundle-budget.mjs --update",
    "audit:local-ci": "bash scripts/audit/local-ci.sh",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "predev": "node scripts/copy-pyodide.mjs",
    "audit:contradictions": "tsx scripts/audit/contradictions.ts",
    "audit:phase-sweep": "node scripts/audit/phase-sweep.mjs",
    "audit:flight": "node scripts/audit/flight-mode.mjs --guest --no-http-cache"
  },
  "dependencies": {
    "@codemirror/commands": "^6.3.3",
    "@codemirror/lang-python": "^6.1.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.26.0",
    "@supabase/supabase-js": "^2.43.0",
    "codemirror": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "pyodide": "^314.0.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
